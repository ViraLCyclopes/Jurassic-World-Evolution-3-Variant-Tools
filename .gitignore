# Game assets -- NEVER commit these. They are Frontier's, not ours to redistribute.
# The folders themselves ship with only their README, which is why those are un-ignored below.
/SwatchLibrary/*
!/SwatchLibrary/*.md
/Textures/*
!/Textures/*.md
*.png
*.dds
*.tex
*.ovl
*.ms2
*.fgm
*.rdc

# Per-user run-time state lives outside the install (see Harvesting/_hpaths.py), but ignore it
# here too in case someone runs an older build in place.
seedsweep_manifest.json
seedsweep_seeds.json
SEEDSWEEP_SPAWN_LIST.txt
Backup_SeedSweep*/

# Design specs and implementation plans are OUR process notes, not documentation for anyone using
# this tool, and they are not for the public repo. They live outside the package, in
# `../docs/superpowers/`. docs/ itself still ships -- GUIDE.md and SLIDERS.md are user-facing.
/docs/superpowers/

